{
  "compilerOptions": {
    "target": "es2020",
    "outDir": "./build",
    "module": "es2020",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*"]
}
